QWidget { color: #30271f; font-family: "Microsoft YaHei UI"; font-size: 14px; }
QMainWindow, QWidget#root { background: #f3eddf; }
QFrame#header { background: #faf6ec; border-bottom: 1px solid #ded3bf; }
QLabel#seal { background: #922d2b; color: #fff5df; border-radius: 5px; font-family: "SimSun"; font-size: 27px; }
QLabel#brand { font-family: "SimSun"; font-size: 27px; font-weight: bold; color: #652c28; }
QLabel#subtitle, QLabel#muted { color: #786b5d; font-size: 12px; }
QLabel#eyebrow { color: #987744; font-size: 12px; }
QLabel#hero { font-family: "SimSun"; font-size: 30px; font-weight: bold; }
QLabel#title { font-family: "SimSun"; font-size: 25px; font-weight: bold; color: #742e29; }
QLabel#section { color: #8e3530; font-weight: bold; margin-top: 10px; }
QLabel#body { line-height: 1.7; }
QFrame#panel { background: #fcf9f1; border: 1px solid #ded4c0; border-radius: 9px; }
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QPushButton { background: #922d2b; color: #fff9ed; border: 1px solid #922d2b; border-radius: 5px; padding: 10px 15px; }
QPushButton:hover { background: #ab3b34; }
QPushButton:pressed { background: #742723; }
QPushButton:disabled { background: #c6b9a2; border-color: #c6b9a2; color: #fffaf1; }
QPushButton[secondary="true"] { background: transparent; color: #766654; border: 1px solid #cfc0a7; }
QPushButton[secondary="true"]:hover { background: #ede3d0; }
QPushButton:focus { border: 2px solid #b68b48; }
QRadioButton, QCheckBox { padding: 9px 5px; spacing: 9px; }
QRadioButton::indicator, QCheckBox::indicator { width: 17px; height: 17px; }
QLabel#feedbackOk { background: #e6eee1; color: #356044; border-radius: 4px; padding: 12px; }
QLabel#feedbackNo { background: #f2e1d8; color: #853e31; border-radius: 4px; padding: 12px; }
QProgressBar { background: #e5dbc9; border: none; border-radius: 3px; min-height: 6px; max-height: 6px; }
QProgressBar::chunk { background: #9b4235; border-radius: 3px; }
QLineEdit { background: #fffdf7; padding: 9px; border: 1px solid #cdbda3; border-radius: 4px; }
QStatusBar { background: #eee5d5; color: #766654; font-size: 12px; }
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: #d0bea1; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
